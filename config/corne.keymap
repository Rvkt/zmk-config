#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define DEFAULT 0
#define LOWER   1
#define RAISE   2
#define ADJUST  3

/ {
    // Hardware bootloader combos (independent of layer or split BLE connection state)
    combos {
        compatible = "zmk,combos";

        // Left half bootloader: Press TAB (0) + Q (1) together
        combo_bootloader_left {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&bootloader>;
            require-prior-idle-ms = <150>;
        };

        // Right half bootloader: Press P (10) + BSPC (11) together
        // Allows putting right half into bootloader over USB even if left half is off/disconnected
        combo_bootloader_right {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&bootloader>;
            require-prior-idle-ms = <150>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp LCTRL &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
               &kp LGUI &mo LOWER &kp SPACE   &kp RET &mo RAISE &kp RALT
            >;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&kp TAB   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6   &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
&kp LCTRL &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp F11   &kp F12
&kp LSHFT &kp F6 &kp F7 &kp F8 &kp F9 &kp F10  &kp HOME &kp PG_DN &kp PG_UP &kp END   &kp PSCRN &kp CAPS
                 &kp LGUI &trans &kp SPACE     &kp RET  &trans    &kp RALT
            >;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&kp TAB   &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&kp LCTRL &none    &none  &none    &none    &none       &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
&kp LSHFT &none    &none  &none    &none    &none       &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                          &kp LGUI &trans   &kp SPACE   &kp RET   &trans    &kp RALT
            >;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&bootloader  &sys_reset   &none        &none        &none        &none          &none        &kp C_PREV   &kp C_PP     &kp C_NEXT   &kp C_VOL_UP &bootloader
&none        &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &none        &none        &none        &kp C_MUTE   &kp C_VOL_DN &sys_reset
&out OUT_TOG &out OUT_BLE &out OUT_USB &none        &bt BT_CLR   &bt BT_CLR_ALL &none        &none        &none        &none        &none        &none
                                        &trans       &trans       &trans         &trans       &trans       &trans
            >;
        };
    };
};
